# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mobimart?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_min_64_chars_long_replace_this_now
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_64_chars_long_replace_this_now
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Email / SMTP ──────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=MobiMart <noreply@mobimart.in>

# ── CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ── Redis (Future) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Razorpay (Future) ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Admin Seed ────────────────────────────────────────────
ADMIN_EMAIL=admin@mobimart.in
ADMIN_PASSWORD=Admin@MobiMart2026!

# ── App ───────────────────────────────────────────────────
APP_NAME=MobiMart
APP_URL=http://localhost:5000
COOKIE_DOMAIN=localhost
